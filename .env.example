# Copia questo file in ".env" e compila i valori.

NOME_NEGOZIO=Le Perle di Ross
DESCRIZIONE_NEGOZIO=Creazioni fatte a mano, personalizzate con amore per le vostre feste.
EMAIL_NEGOZIO=

# Password per vedere gli ordini su /admin (utente: admin)
ADMIN_PASSWORD=cambiami

# Spedizione con InPost (euro). Metti 0 in SPEDIZIONE_GRATIS_DA per non avere la soglia.
SPEDIZIONE_EURO=4.90
SPEDIZIONE_GRATIS_DA=50
# Consegna a domicilio con il corriere InPost (solo alcune zone d'Italia)
INPOST_DOMICILIO=false
SPEDIZIONE_DOMICILIO_EURO=6.90

# Stile grafico: neve | bosco | kraft | notte
TEMA=neve
# Mostra in basso i pulsanti per provare gli stili (metti false quando hai scelto)
MOSTRA_SCELTA_TEMA=true

# PayPal: crea un'app su https://developer.paypal.com/dashboard/applications
# Usa prima "sandbox" per le prove, poi "live" con le credenziali reali.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# NODE_ENV=production
# PORT=3000

# InPost: credenziali API dal referente InPost (Integration Team / Merchant Portal)
# INPOST_ENV=stage per le prove, production per le spedizioni vere
INPOST_ENV=stage
INPOST_CLIENT_ID=
INPOST_CLIENT_SECRET=
INPOST_ORGANIZATION_ID=
# Chiave della mappa dei Locker (Geowidget), legata al dominio del sito
INPOST_GEOWIDGET_TOKEN=
# Dove consegni i pacchi: ANY_POINT (qualsiasi Locker o punto), APM (Locker), PUDO (punto)
INPOST_ORIGINE=ANY_POINT
# Mittente stampato sull'etichetta
INPOST_MITTENTE_NOME=
INPOST_MITTENTE_COGNOME=
INPOST_MITTENTE_EMAIL=
INPOST_MITTENTE_TELEFONO=+39
